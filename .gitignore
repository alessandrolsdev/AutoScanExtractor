# Pastas e arquivos de compilação do PyInstaller
/build/
/dist/
*.spec
# O .spec do projeto é versionado de propósito: sem ele o build documentado no
# README não é reproduzível por quem clona o repositório.
!AutoScanExtractor.spec

# Cache e logs do Python
__pycache__/
*.log
*.pyc

# Cache do Pytest
.pytest_cache/

# Arquivos de ambiente virtual (ex: venv, .venv)
venv/
.venv/
env/
.env/

# Arquivos de saída gerados pelo bot
*.xlsx
*.csv

# Arquivos do sistema operacional
.DS_Store
Thumbs.db